#!/bin/bash
set -euo pipefail

# Query ALL sessions from opencode DB regardless of project
output=$(opencode db "SELECT id || '\t' || substr(title, 1, 80) || '\t' || datetime(time_updated/1000, 'unixepoch') FROM session ORDER BY time_updated DESC" --format tsv 2>/dev/null || true)

# Handle empty results
if [[ -z "$output" ]]; then
  echo "No sessions found."
  exit 1
fi

# Format display: title  |  date
formatted=$(echo "$output" | awk -F'\t' '{printf "%s  |  %s\t%s\n", $2, $3, $1}')

# Show fzf picker
selection=$(echo "$formatted" | fzf --reverse --height=60% --prompt="Session: " --no-multi) || exit 0

# Extract session ID (last field after tab)
session_id=$(echo "$selection" | awk -F'\t' '{print $NF}')

# Launch selected session
exec opencode -s "$session_id" "$@"
