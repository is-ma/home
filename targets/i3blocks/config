# i3blocks config - minimal
#
# See man i3blocks for complete reference.

command=/usr/share/i3blocks/$BLOCK_NAME
separator_block_width=15
markup=none

# Weather
[weather]
command=$HOME/.config/i3blocks/scripts/weather
color=#89b482
interval=3600

# Network Speed
[net_speed]
command=$HOME/.config/i3blocks/scripts/net_speed
color=#e78a4e
interval=5

# OpenCode Go
[opencode_go]
command=$HOME/.config/i3blocks/scripts/opencode_go
color=#7daea3
interval=3600

# WiFi
[wifi]
command=$HOME/.config/i3blocks/scripts/wifi
instance=wlo1
color=#d8a657
interval=10

# Uptime
[uptime]
command=$HOME/.config/i3blocks/scripts/uptime
label=󰥔
color=#d3869b
interval=60

# Battery
[battery]
command=$HOME/.config/i3blocks/scripts/battery
color=#a9b665
interval=60

# Volume
[volume]
command=$HOME/.config/i3blocks/scripts/volume
color=#e78a4e
interval=10
signal=10

# CPU
[cpu_usage]
command=$HOME/.config/i3blocks/scripts/cpu_usage
label=󰟀
color=#d8a657
interval=5

# Memory
[memory]
command=$HOME/.config/i3blocks/scripts/memory
label=󰆼
color=#d3869b
interval=5

# Date & time
[time]
command=date '+%a %d/%b %H:%M:%S'
color=#ea6962
interval=1

# Caps Lock
[keyindicator]
command=$HOME/.config/i3blocks/scripts/keyindicator -c '#ddc7a1' -C '#3c3836'
instance=CAPS
interval=once
signal=11
